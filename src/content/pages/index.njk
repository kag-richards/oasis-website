  <div class="wrap">
    <div class="split flip">
      <div class="split-visual reveal">
        <figure class="figure">
          <img src="/assets/images/photos/giving-day.webp" alt="Car keys, a small stack of gift cards and a folded blanket on a sunlit table." width="1536" height="1024" loading="lazy" decoding="async">
