---
layout: layouts/base.njk
---

<section class="hero">
  {# Reference grammar (kyle-templates/construx-BUILD-hero.jpg, rental-property.webp):
     an inset framed image, one giant tonal word living INSIDE the scene with a real
     foreground cutout occluding it, and a fact strip breaking the frame's bottom edge
     so the CTA lands above the fold. #}
  <div class="hero-frame">
    <img class="hero-bg" src="/assets/images/photos/hero-home-day.webp" alt="" width="1920" height="1080" fetchpriority="high" decoding="async">
    <div class="hero-lede">
      <h1>{{ home.heading_line1 }}<br>{{ home.heading_pre }} <em>{{ home.heading_accent }}</em> {{ home.heading_post }}</h1>
      <p>{{ home.subtext }}</p>
    </div>
    <img class="hero-fg" src="/assets/images/photos/hero-foreground.webp" alt="A single story house with a covered front porch in bright morning light." width="1920" height="1080" decoding="async">
  </div>

  <div class="hero-strip">
      <ul class="hero-facts">
        {%- for st in home.stats %}
        <li><strong>{{ st.number }}</strong><span>{{ st.fact or st.label }}</span></li>
        {%- endfor %}
      </ul>
      <a class="btn btn-primary hero-cta" href="{{ site.donation_url }}" target="_blank" rel="noopener">
        Give toward the house
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>

{{ content | safe }}
