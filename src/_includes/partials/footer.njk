<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <img class="footer-logo" src="/assets/images/logo-lockup.svg" alt="{{ site.title }}" width="320" height="100">
        <p class="footer-mission">{{ site.tagline }}</p>
      </div>

      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/founder/">Our Founder</a></li>
          <li><a href="/programs/">Our Programs</a></li>
          <li><a href="/give/">Ways to Give</a></li>
          <li><a href="/blog/">News</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4>Reach Us</h4>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="tel:{{ site.phone | replace('-', '') }}">{{ site.phone }}</a></li>
          <li>{{ site.city }}, {{ site.state }}{% if site.zip %} {{ site.zip }}{% endif %}</li>
        </ul>
      </div>

      <div>
        <h4>Support the House</h4>
        <p style="margin-bottom:20px;line-height:1.7;">Every gift right now goes toward opening our first transitional home in Denton County.</p>
        <a class="btn btn-primary" href="{{ site.donation_url }}" target="_blank" rel="noopener" style="padding:13px 26px;font-size:14.5px;">
          Give today
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-legal">
      <span>&copy; {% year %} {{ site.title }}. All rights reserved.</span>
      <span class="legal-meta"><span>{{ site.legal_status }}</span><span class="sep" aria-hidden="true"> &middot; </span><span class="nowrap">EIN {{ site.ein }}</span></span>
    </div>
  </div>
</footer>
